# Copy this file to .env.local for local development.
# NEVER commit .env.local to GitHub.
# Only the PUBLIC key goes here (anon or sb_publishable_...).
# NEVER put a service-role / secret key or a database password here.

VITE_APP_NAME=Luxe Marketplace
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave EMPTY in production (demo products stay hidden).
# Set to true only on your own computer to preview demo products.
VITE_SHOW_DEMO_PRODUCTS=
